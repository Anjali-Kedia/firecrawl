{
    "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
    "low": true,
    "allowlist": [
        // GHSA-v2v4-37r5-5v8g / GHSA-mwp4-54f8-5fhr (ip-address):
        // geoip-country still depends on ip-address 6.x; the non-affected
        // line is a multi-major jump outside the upstream range.
        // Do not override across majors without compatibility approval.
        // Owner: team-engineering-reviewers. Tracking: create internal ticket.
        // Expires: 2026-10-08.
        "GHSA-v2v4-37r5-5v8g",
        "GHSA-mwp4-54f8-5fhr",
        // GHSA-rpw4-54j3-4h4q: the API calls geoip-country.lookup(req.ip).
        // That request path uses Node's net module and does not load ip-address.
        // geoip-country declares ip-address 6.x as a runtime dependency, but
        // only its database update script imports it; the API does not call it.
        // The fix is in 10.x and requires upstream compatibility work.
        // Owner: API maintainers. Tracking: GHSA-rpw4-54j3-4h4q.
        // Expires: 2026-10-08.
        "GHSA-rpw4-54j3-4h4q"
    ]
}
